{
  "manifest_version": 3,
  "name": "IzzI 5.1 YouTube Enhancements",
  "version": "4.2.0",
  "key": "",
  "description": "Real 5.1 surround for YouTube, plus extra volume, fill-screen crop and one-click picture-in-picture.",
  "author": "IzzIsHOr",
  "homepage_url": "https://github.com/IzzIsHOr/izzi-surround-51",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IzzI 5.1 YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/play16.png",
      "32": "icons/play32.png",
      "48": "icons/play48.png",
      "128": "icons/play128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "upmix.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
